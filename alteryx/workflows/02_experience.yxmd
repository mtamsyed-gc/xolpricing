<Node ToolID="12"><GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula"><Position x="690" y="110" /></GuiSettings><Properties><Configuration><FormulaFields><FormulaField expression='DateTimeFormat([p_treaty_start], "%m-%d")' field="ts_md" size="1073741823" type="V_WString" /><FormulaField expression='DateTimeFormat([p_treaty_start], "%m")' field="ts_mm" size="1073741823" type="V_WString" /><FormulaField expression='ToDate(DateTimeTrim([m_valuation_date], "firstofmonth"))' field="val_month" size="10" type="Date" /><FormulaField expression='[p_treaty_basis] = "RA"' field="is_ra" size="1" type="Bool" /><FormulaField expression="([amount_paid_q] + [amount_os_q]) * [p_qs_cedant_retention_pct]" field="amount_q" size="8" type="Double" /><FormulaField expression="[amount_paid_q] * [p_qs_cedant_retention_pct]" field="paid_q" size="8" type="Double" /><FormulaField expression="[amount_os_q] * [p_qs_cedant_retention_pct]" field="os_q" size="8" type="Double" /><FormulaField expression='IIF([p_claims_trigger] = "PAID" AND !IsNull([paid_date]), [paid_date], IIF([p_claims_trigger] = "PAID", [m_valuation_date], [treatment_date]))' field="trigger_date" size="10" type="Date" /><FormulaField expression='IIF([is_ra], DateTimeYear([cohort_month]) - IIF(DateTimeFormat([cohort_month], "%m-%d") &lt; [ts_md], 1, 0), DateTimeYear([trigger_date]) - IIF(DateTimeFormat([trigger_date], "%m-%d") &lt; [ts_md], 1, 0))' field="ty" size="8" type="Int64" /><FormulaField expression='ToDate(ToString([ty]) + "-" + [ts_mm] + "-01")' field="ty_start" size="10" type="Date" /><FormulaField expression='IIF(IsNull([p_paid_runoff_months]), Null(), ToDate(DateTimeAdd(DateTimeAdd([ty_start], 12 + [p_paid_runoff_months], "months"), -1, "days")))' field="runoff_end" size="10" type="Date" /><FormulaField expression="IIF(IsNull([runoff_end]) OR IsNull([paid_date]), 1=0, [paid_date] &gt; [runoff_end])" field="late_paid" size="1" type="Bool" /><FormulaField expression='FindString("," + [p_years_included] + ",", "," + ToString([ty]) + ",") &gt;= 0' field="in_years" size="1" type="Bool" /><FormulaField expression='IIF([grain] = "CLAIMANT", [claim_key], [member_id] + IIF([p_pp_accumulation] = "POLICY_YEAR" AND !IsNull([policy_id]), "|" + [policy_id], "")) + "|" + ToString([ty])' field="acc_key" size="1073741823" type="V_WString" /></FormulaFields></Configuration><Annotation DisplayMode="0"><Name>claims: treaty calendar; treaty year, run-off, unit key</Name><DefaultAnnotationText /><Left value="False" /></Annotation></Properties><EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" /></Node>
