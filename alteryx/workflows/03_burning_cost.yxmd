<Node ToolID="126"><GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula"><Position x="1050" y="2300" /></GuiSettings><Properties><Configuration><FormulaFields><FormulaField expression="[bc_pppy_weighted_non] + [bc_pppy_outlier]" field="bc_pppy_total" size="8" type="Double" /><FormulaField expression="IIF([n_xl_claims] &gt;= [p_full_cred_n], 1, Sqrt([n_xl_claims] / [p_full_cred_n]))" field="credibility_z" size="8" type="Double" /><FormulaField expression="[bc_sum] / [n_years]" field="sens_straight_mean" size="8" type="Double" /><FormulaField expression="IIF([n_completed] &gt; 0, [xl_c_total] / [n_completed], 0)" field="severity_pooled" size="8" type="Double" /><FormulaField expression="[freq_weighted] / 1000 * [severity_pooled]" field="sens_wfreq_x_sev" size="8" type="Double" /><FormulaField expression="[freq_sum] / [n_years] / 1000 * [severity_pooled]" field="sens_sfreq_x_sev" size="8" type="Double" /><FormulaField expression="IIF([xl_less1_total] &gt; 0, [xl_total] / [xl_less1_total] - 1, Null())" field="lev_trend" size="8" type="Double" /><FormulaField expression="IIF(IsNull([lev_trend]) OR [base_trend] = 0, Null(), [lev_trend] / [base_trend])" field="leverage_factor" size="8" type="Double" /><FormulaField expression="IIF(IsNull([p_expected_lives_quote_year]), [p_epi_quote_year] / ([exposure_prem_full] / [exposure_ly_full] * [prem_trend_f]), [p_expected_lives_quote_year])" field="lives_quote_year" size="8" type="Double" /><FormulaField expression="[bc_pppy_total] * [lives_quote_year] * [p_incidence_adj]" field="expected_cost_det" size="8" type="Double" /><FormulaField expression="[expected_cost_det] / [p_epi_quote_year]" field="expected_cost_pct_epi" size="8" type="Double" /><FormulaField expression="[bc_pct_prem_weighted] * [p_epi_quote_year] * [p_incidence_adj]" field="expected_cost_from_pct" size="8" type="Double" /></FormulaFields></Configuration><Annotation DisplayMode="0"><Name>summary measures</Name><DefaultAnnotationText /><Left value="False" /></Annotation></Properties><EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" /></Node>
